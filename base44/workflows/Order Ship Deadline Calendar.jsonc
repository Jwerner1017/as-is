{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "order_ship_deadline_calendar",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_deadline": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "create-order-ship-deadline",
            "args": {
              "order_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create ship deadline",
            "description": "Google Calendar event 2 days out"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "description": "Creates a Google Calendar ship-by deadline entry when a new order is placed, set 2 days after order creation",
  "name": "Order Ship Deadline Calendar"
}